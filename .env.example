# Copy to .env and fill in. .env is gitignored; never commit real values.

# dev | test | prod. Selects config.<env>.toml and the safety rules.
JOBBOT_ENV=dev

# Local Postgres (docker compose up -d db). For Supabase use the pooled string (port 6543).
JOBBOT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobbot_dev
# Direct connection (port 5432 on Supabase), used only by migrations. Leave empty locally.
JOBBOT_DATABASE_URL_DIRECT=

# Comma-separated emails allowed to log in. Seeded by migration 0002.
JOBBOT_ALLOWED_EMAILS=you@example.com

# Outside prod, every email is redirected here.
JOBBOT_EMAIL_TEST_TO=you@example.com
JOBBOT_EMAIL_FROM=Shortlist <digest@mail.yourdomain.com>
JOBBOT_RESEND_API_KEY=

# Not used until later phases; set provider-side spending limits when you create them.
JOBBOT_OPENAI_API_KEY=
JOBBOT_ANTHROPIC_API_KEY=
